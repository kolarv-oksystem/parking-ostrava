    },
    {
      "name": "Poslední změny",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/events?limit=15",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "events"
          ],
          "query": [
            {
              "key": "limit",
              "value": "15"
            }
          ]
        }
      }
    },
    {
      "name": "Toggle spot (služební vozidlo, bez GPS)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"device_id\": \"{{deviceId}}\",\n  \"name\": \"{{userName}}\",\n  \"spot_number\": 1,\n  \"vehicle_type\": \"service\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/spots/toggle",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "spots",
            "toggle"
          ]
        }
      }
    },
    {
      "name": "Toggle spot (místo 2 + GPS)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"device_id\": \"{{deviceId}}\",\n  \"name\": \"{{userName}}\",\n  \"spot_number\": 2,\n  \"latitude\": {{latitude}},\n  \"longitude\": {{longitude}},\n  \"accuracy\": 15\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/spots/toggle",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "spots",
            "toggle"
          ]
        }
      }
    },
    {
      "name": "Toggle service reservation",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",

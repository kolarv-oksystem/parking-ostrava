        },
        "url": {
          "raw": "{{baseUrl}}/api/spots/toggle-service-reservation",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "spots",
            "toggle-service-reservation"
          ]
        }
      }
